# ---------------------------------------------------------------- Supabase --
# Production. Get both from Project Settings -> API in the Supabase dashboard.
# Run supabase/migrations/0001_init.sql first (supabase db push, or paste it
# into the SQL editor) — the Supabase driver does not create its own schema.
#
# SUPABASE_SERVICE_ROLE_KEY is a secret. Never prefix it with NEXT_PUBLIC_,
# never reference it from a client component. It bypasses row level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------- Other Postgres --
# Only used when the Supabase pair above is absent. Creates its own schema.
# DATABASE_URL=postgres://user:pass@host/db

# ------------------------------------------------------------------- Local --
# With none of the above set, results go to .data/thanos.db via node:sqlite.
# No setup required.

# ------------------------------------------------------------------ Support --
# The ask between the last answer and the result. Leave all of these unset and
# the step is skipped entirely.
#
# Patreon prices one purchasable post at one fixed amount, so each price point
# is its own post and its own entry here. Format: amount=url, comma separated.
NEXT_PUBLIC_SUPPORT_TIERS=10=https://www.patreon.com/posts/111,20=https://www.patreon.com/posts/222

# Patreon cannot take a customer-chosen amount. If you want "any amount", it has
# to come from somewhere that supports it. Allowed hosts: patreon.com, ko-fi.com,
# buymeacoffee.com, buy.stripe.com, donate.stripe.com, paypal.me.
NEXT_PUBLIC_SUPPORT_CUSTOM_URL=https://ko-fi.com/your-page

# Symbol shown on the amount buttons.
NEXT_PUBLIC_SUPPORT_CURRENCY=$

# Single-link fallback, used only when no tiers and no custom URL are set.
# Strictly patreon.com.
NEXT_PUBLIC_PATREON_URL=https://www.patreon.com/your-page
